# OpenAI-compatible endpoint used for all LLM calls
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model used for PoC generation, repair and differential verification
SMARTPOC_MODEL=DeepSeek-R1

# Model used by the report preprocessing scripts in scripts/Preprocess
SMARTPOC_PREPROCESS_MODEL=deepseek-chat

# Optional: comma-separated RPC URLs; when set, forge tests run with --fork-url
SMARTPOC_RPC_URLS=

# Root of the FORGE dataset (the directory containing dataset/contracts)
FORGE_ROOT=
